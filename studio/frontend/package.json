{
  "name": "unsloth-theme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "bundle:check": "node --experimental-strip-types scripts/check-bundle-budget.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "i18n:check": "node --experimental-strip-types --no-warnings src/i18n/check-parity.ts",
    "i18n:check:strict": "node --experimental-strip-types --no-warnings src/i18n/check-parity.ts --strict",
    "catalog:check": "node --experimental-strip-types --no-warnings src/features/model-picker/components/model-selector/model-catalog.check.ts",
    "catalog:check:network": "node --experimental-strip-types --no-warnings src/features/model-picker/components/model-selector/model-catalog.check.ts --network",
    "biome:check": "biome check",
    "biome:fix": "biome check --write"
  },
